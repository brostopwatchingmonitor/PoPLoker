# LokerPintar Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# DATABASE (Neon Serverless Postgres)
# ============================================

# Get this from your Neon dashboard
# Format: postgres://username:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://username:password@host.neon.tech/lokerpintar?sslmode=require

# ============================================
# MIDTRANS PAYMENT GATEWAY
# ============================================

# Get these from Midtrans Dashboard (https://dashboard.midtrans.com)
MIDTRANS_SERVER_KEY=your_server_key_here
MIDTRANS_CLIENT_KEY=your_client_key_here

# Use sandbox for development, production for live
MIDTRANS_IS_PRODUCTION=false

# ============================================
# AUTHENTICATION
# ============================================

# Generate a secure random string (32+ characters)
# Run: openssl rand -base64 32
AUTH_SECRET=your_secret_key_here_at_least_32_characters_long

# ============================================
# APPLICATION
# ============================================

# Your application URL (for Vercel, this will be auto-set)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Additional configuration
NODE_ENV=development